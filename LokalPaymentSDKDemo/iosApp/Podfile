platform :ios, '16.0'
use_frameworks!

# >>> lokal-payment-sdk bootstrap (managed by shared-cocoapods on Gradle sync) — DO NOT EDIT OR DELETE.
# Regenerated on every Gradle sync; manual changes between these markers are overwritten.
# Required to run the Lokal Payment SDK. Unpacks every Maven-sourced iOS pod source AND
# generates the pod helper via the shared-cocoapods Gradle plugin, then loads it. Runs at
# Podfile-evaluation time (NOT pre_install): require_relative below needs the file present.
unless system("../gradlew", "-p", "..", ":composeApp:prepareLokalIosPods")
  raise "prepareLokalIosPods failed — are the SDK iossrc artifacts published to Maven?"
end
require_relative '../composeApp/build/lokal/lokal_ios_pods.rb'
# <<< lokal-payment-sdk bootstrap

target 'iosApp' do
  # >>> lokal-payment-sdk pods (managed by shared-cocoapods on Gradle sync) — DO NOT EDIT OR DELETE.
  # Regenerated every sync. Required to run the Lokal Payment SDK. Inserted into the FIRST
  # target in this Podfile; declares a :path pod for each first-party pod auto-discovered
  # from Maven (pod name = .podspec filename). To attach these pods to a different target,
  # make that target the first one in this Podfile.
  lokal_ios_pods
  # <<< lokal-payment-sdk pods

  # The Compose Multiplatform demo framework. The Lokal Payment SDK is compiled
  # into this framework via its Maven dependency, so we no longer pull `pod 'Shared'`.
  pod 'composeApp', :path => '../composeApp'
end

post_install do |installer|
  # Juspay's asset pipeline: downloads/places merchant assets for the clientId in
  # MerchantConfig.txt. Without this, HyperSDK's "[CP-User] Validate Mandatory
  # Files" build phase fails the app build.
  fuse_path = "./Pods/HyperSDK/Fuse.rb"
  clean_assets = false # pass true to force re-downloading all assets
  if File.exist?(fuse_path)
    system("ruby", fuse_path.to_s, clean_assets.to_s)
  end
end
