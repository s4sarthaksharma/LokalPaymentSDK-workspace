platform :ios, '16.0'
use_frameworks!

target 'iosApp' do
  # The Compose Multiplatform demo framework. The Lokal Payment SDK is compiled
  # into this framework via its Maven dependency, so we no longer pull `pod 'Shared'`.
  pod 'composeApp', :path => '../composeApp'

  # Vendor pods (razorpay-pod, HyperSDK) are declared transitively by
  # composeApp.podspec — injected there by the Lokal SDK's cocoapods-host Gradle
  # plugins, so no vendor pod is named here. CocoaPods resolves them from trunk.

  # NativeIapBridge is a *local* pod (LokalPaymentSDK/native-iap/ios/NativeIapBridge),
  # not a trunk-hosted one — unlike razorpay-pod/HyperSDK above, a `spec.dependency`
  # injected into composeApp.podspec can't carry a filesystem path (that's a
  # Podfile-only concept in CocoaPods), so this line has to live here directly
  # rather than being auto-injected by a cocoapods-host plugin.
  pod 'NativeIapBridge', :path => '../../LokalPaymentSDK/native-iap/ios/NativeIapBridge'
end

post_install do |installer|
  # Juspay's asset pipeline: downloads/places merchant assets for the clientId in
  # MerchantConfig.txt. Without this, HyperSDK's "[CP-User] Validate Mandatory
  # Files" build phase fails the app build.
  fuse_path = "./Pods/HyperSDK/Fuse.rb"
  clean_assets = false # pass true to force re-downloading all assets
  if File.exist?(fuse_path)
    system("ruby", fuse_path.to_s, clean_assets.to_s)
  end
end
