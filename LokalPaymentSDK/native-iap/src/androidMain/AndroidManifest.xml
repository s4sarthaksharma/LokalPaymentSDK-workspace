<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Auto-init: registers NATIVE_IAP as unavailable at process start
             (Play Billing isn't implemented yet) — zero host code, the same
             App Startup mechanism every gateway module uses. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.getlokalapp.paymentsdk.nativeiap.NativeIapUnavailableInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
