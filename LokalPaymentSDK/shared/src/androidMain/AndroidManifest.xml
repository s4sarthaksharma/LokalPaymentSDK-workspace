<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility (Android 11+) so LokalPaymentSdk.installedUpiApps()
         can see every app that handles the standard upi://pay deep link when
         it queries PackageManager. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <!-- Auto-init, zero host code, via AndroidX App Startup. This is the SDK's
         single startup provider: every gateway module contributes its own
         Initializer as a <meta-data> merged into this same provider (keyed by
         class name), so no gateway module needs a provider — or a unique
         android:authorities — of its own. This entry installs the
         current-Activity tracker; gateway initializers depend on it, so it
         runs first. -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.getlokalapp.paymentsdk.PaymentSdkInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
