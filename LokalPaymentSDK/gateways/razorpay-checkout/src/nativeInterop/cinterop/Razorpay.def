# Direct Kotlin/Native cinterop against Razorpay.xcframework (fetched by
# fetchRazorpayXcFramework in build.gradle.kts), with ZERO CocoaPods. `package`
# is the Kotlin package the generated bindings land in — iosMain imports it as
# vendor.razorpay.*.
language = Objective-C
modules = Razorpay
package = vendor.razorpay
