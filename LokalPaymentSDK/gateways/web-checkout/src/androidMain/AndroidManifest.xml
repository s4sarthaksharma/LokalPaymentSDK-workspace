<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Auto-init: registers WebCheckoutSdk with LokalPaymentSdk at process
         start, zero host code (see the initializer's kdoc). Contributed to App
         Startup's single provider as a <meta-data>. No Activity here — the
         WebView Activity and INTERNET permission come from :webview. -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.getlokalapp.paymentsdk.webcheckout.WebCheckoutInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
