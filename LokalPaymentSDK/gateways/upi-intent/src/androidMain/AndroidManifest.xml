<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to fetch the backend-supplied UPI app logos (allowed_apps.logo_url)
         shown in the chooser. Normal permission, auto-granted; merged into the
         host (virtually every app already declares it). Without a logo_url the
         chooser makes no network call and falls back to the OS launcher icon. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Proxy Activity that fronts the UPI intent (startActivityForResult).
         Merged into the host app so the SDK is self-contained: consumers
         register nothing. Translucent so only the UPI app's screen shows. -->
    <application>
        <!-- configChanges is wide on purpose: every recreation avoided is a payment that
             would otherwise have to be settled without a real result, since the platform
             reports only to the instance that launched. -->
        <activity
            android:name="com.getlokalapp.paymentsdk.upiintent.UpiIntentActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|density|fontScale"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Auto-init: registers UpiIntentSdk with LokalPaymentSdk at process
             start, zero host code (see the initializer's kdoc). Contributed to
             App Startup's single provider as a <meta-data>. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.getlokalapp.paymentsdk.upiintent.UpiIntentInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
