<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Proxy Activity that fronts Razorpay's Custom UI (Razorpay.submit()) flow.
         Merged into the host app so the SDK is self-contained: consumers don't
         register anything. -->
    <application>
        <!-- configChanges is wide on purpose: every recreation avoided is a payment that
             would otherwise have to be settled without a real result, since the platform
             reports only to the instance that launched. -->
        <activity
            android:name="com.getlokalapp.paymentsdk.razorpay.RazorpayCustomUiActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|density|fontScale"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Auto-init: registers RazorpayCustomUiSdk with LokalPaymentSdk at
             process start, zero host code (see the initializer's kdoc).
             Contributed to App Startup's single provider as a <meta-data>. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.getlokalapp.paymentsdk.razorpay.RazorpayCustomUiInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
